---
const title = 'Painel do Portfólio | Letícia Leite';
---
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex,nofollow" />
  <title>{title}</title>
  <style>
    :root{--wine:#9c3f3f;--wine-dark:#7a3131;--rose:#d88c88;--cream:#f8f3ed;--ink:#282321;--muted:#756b66;--line:#e5dcd6;--card:#fff}
    *{box-sizing:border-box} body{margin:0;background:#f4f1ed;color:var(--ink);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif}
    button,input,select{font:inherit}.shell{max-width:1440px;margin:0 auto;padding:28px}.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-bottom:24px}
    .topbar h1{margin:0;font:700 30px/1.1 Georgia,serif}.topbar p{margin:6px 0 0;color:var(--muted)}.site-link{padding:11px 16px;border-radius:12px;background:#fff;color:var(--wine);border:1px solid var(--line);text-decoration:none;font-weight:700}
    .workspace{display:grid;grid-template-columns:470px minmax(0,1fr);gap:24px;align-items:start}.panel,.preview-card{background:var(--card);border:1px solid var(--line);border-radius:22px;box-shadow:0 14px 40px rgba(78,56,48,.07)}
    .panel{padding:22px}.panel h2{margin:0 0 16px;font-size:19px}.block{padding:18px 0;border-top:1px solid #eee7e2}.block:first-of-type{border-top:0;padding-top:0}
    label{display:block;font-size:13px;font-weight:700;margin-bottom:7px}input[type="password"],select{width:100%;border:1px solid var(--line);border-radius:11px;padding:11px 12px;background:#fff}
    input[type="file"]{width:100%;font-size:12px}input[type="range"]{width:100%;accent-color:var(--wine)}.range-row{display:grid;grid-template-columns:1fr 58px;gap:10px;align-items:center;margin:12px 0}
    .range-value{text-align:center;padding:8px 5px;border-radius:9px;background:#f5efeb;color:var(--wine);font-size:12px;font-weight:800}
    .media-grid{display:grid;gap:14px}.media-editor{padding:14px;border:1px solid var(--line);border-radius:16px;background:#fbf9f7}.media-editor-head{display:flex;align-items:center;justify-content:space-between;gap:8px;margin-bottom:10px}
    .media-editor-head strong{font-size:14px}.media-editor-head span{font-size:11px;color:var(--muted);background:#f0e8e3;padding:5px 8px;border-radius:999px}
    .editor-preview{height:170px;overflow:hidden;border-radius:13px;background:#e9dfd9;margin-bottom:12px;display:grid;place-items:center}.editor-preview.profile{height:140px;background:#f1ebe6}
    .editor-preview img,.editor-preview video{width:100%;height:100%;object-fit:cover;object-position:50% 50%;transform:scale(1);transform-origin:center;display:block}
    .editor-preview.profile img{width:118px;height:118px;border-radius:50%;border:4px solid #fff}.media-controls{display:grid;grid-template-columns:1fr 1fr;gap:10px 12px;margin-top:12px}
    .media-controls .full{grid-column:1/-1}.mini-range{display:grid;grid-template-columns:1fr 50px;gap:6px;align-items:end}.mini-range label{margin:0}.mini-range span{font-size:11px;font-weight:800;color:var(--wine);text-align:right}
    .actions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}.button{border:0;border-radius:12px;padding:13px 15px;cursor:pointer;font-weight:800}.button-primary{background:var(--wine);color:#fff}.button-primary:hover{background:var(--wine-dark)}
    .button-secondary{background:#f0e8e3;color:var(--wine)}.status{min-height:40px;margin-top:14px;padding:11px 12px;border-radius:11px;background:#f8f5f2;color:var(--muted);font-size:13px;line-height:1.4}
    .status.ok{background:#eef7ef;color:#296236}.status.error{background:#fff0ef;color:#9a3530}.preview-card{position:sticky;top:20px;overflow:hidden}.preview-toolbar{display:flex;align-items:center;justify-content:space-between;padding:13px 16px;border-bottom:1px solid var(--line);background:#fff}
    .preview-toolbar span{font-size:13px;color:var(--muted)}.preview{position:relative;min-height:760px;overflow:hidden;background:var(--cream)}.preview-bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 52%;transform:scale(1);opacity:1}
    .preview-scroll{position:relative;z-index:2;padding:40px 28px 50px}.preview-content{width:min(620px,100%);margin:0 auto;padding:42px 30px;text-align:center;border-radius:30px;background:rgba(253,251,247,.63);backdrop-filter:blur(2px)}
    .preview-avatar-wrap{width:118px;height:118px;margin:0 auto;overflow:hidden;border-radius:50%;border:5px solid #fff;background:#eee4de;box-shadow:0 10px 26px rgba(90,58,50,.14)}
    .preview-avatar{width:100%;height:100%;object-fit:cover;object-position:50% 50%;transform:scale(1);display:block}.preview-kicker{color:var(--rose);font-size:11px;text-transform:uppercase;letter-spacing:1.7px;font-weight:800;margin-top:20px}
    .preview h2{color:var(--wine);font:700 clamp(42px,7vw,64px)/1 Georgia,serif;margin:9px 0 14px}.preview p{color:var(--muted);margin:0 auto 24px;max-width:460px}.mock-links{display:grid;gap:10px;max-width:480px;margin:0 auto}
    .mock-links span{display:block;background:rgba(255,255,255,.9);border:1px solid #e7ddd7;border-radius:14px;padding:13px;font-weight:700;font-size:13px}.mock-links span:last-child{background:var(--wine);color:#fff}
    .mini-title{text-align:center;margin:34px 0 16px;color:var(--wine);font:italic 700 26px Georgia,serif}.portfolio-preview-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;max-width:720px;margin:0 auto}
    .portfolio-preview-item{overflow:hidden;border-radius:18px;background:#fff;box-shadow:0 8px 24px rgba(68,44,36,.1)}.portfolio-preview-media{aspect-ratio:4/5;overflow:hidden;background:#e8ddd6}
    .portfolio-preview-media img,.portfolio-preview-media video{width:100%;height:100%;display:block;object-fit:cover;object-position:50% 50%;transform:scale(1);transform-origin:center}.portfolio-preview-label{padding:10px 12px;font-size:11px;font-weight:800;color:var(--wine)}
    .hint{margin:8px 0 0;color:var(--muted);font-size:12px;line-height:1.45}
    @media(max-width:1050px){.workspace{grid-template-columns:1fr}.preview-card{position:static}}@media(max-width:650px){.shell{padding:14px}.topbar{align-items:flex-start;flex-direction:column}.actions{grid-template-columns:1fr}.media-controls{grid-template-columns:1fr}.media-controls .full{grid-column:auto}.portfolio-preview-grid{grid-template-columns:1fr}.preview-scroll{padding:24px 14px}.preview-content{padding:34px 18px}}
  </style>
</head>
<body>
<div class="shell">
  <div class="topbar"><div><h1>Painel do Portfólio</h1><p>Troque e enquadre cada foto e vídeo sem editar código.</p></div><a class="site-link" href="/" target="_blank">Abrir site público ↗</a></div>
  <div class="workspace">
    <section class="panel">
      <div class="block">
        <h2>Acesso</h2>
        <label for="admin-password">Senha do painel</label>
        <input id="admin-password" type="password" autocomplete="current-password" placeholder="Digite a senha" />
        <p class="hint">Você pode montar toda a prévia antes de salvar.</p>
      </div>

      <div class="block">
        <h2>Foto de fundo</h2>
        <label for="background-file">Escolher nova foto</label>
        <input id="background-file" type="file" accept="image/jpeg,image/png,image/webp,image/avif" />
        <div class="range-row"><div><label for="opacity">Opacidade</label><input id="opacity" type="range" min="0" max="100" value="100" /></div><span id="opacity-value" class="range-value">100%</span></div>
        <div class="range-row"><div><label for="zoom">Zoom</label><input id="zoom" type="range" min="70" max="220" value="100" /></div><span id="zoom-value" class="range-value">100%</span></div>
        <div class="range-row"><div><label for="position-x">Posição horizontal</label><input id="position-x" type="range" min="0" max="100" value="50" /></div><span id="position-x-value" class="range-value">50%</span></div>
        <div class="range-row"><div><label for="position-y">Posição vertical</label><input id="position-y" type="range" min="0" max="100" value="52" /></div><span id="position-y-value" class="range-value">52%</span></div>
        <label for="fit">Encaixe</label><select id="fit"><option value="cover">Cobrir toda a tela</option><option value="contain">Mostrar foto inteira</option></select>
      </div>

      <div class="block">
        <h2>Mídias do portfólio</h2>
        <div id="media-editors" class="media-grid">
          <div class="media-editor" data-kind="profile" data-type="image">
            <div class="media-editor-head"><strong>Foto redonda da Letícia</strong><span>Foto</span></div>
            <div class="editor-preview profile"><img id="editor-profile-preview" alt="" /></div>
            <input id="profile-file" type="file" accept="image/*" />
            <div class="media-controls">
              <div class="mini-range"><label>Zoom</label><span id="profile-zoom-value">100%</span><input class="full" id="profile-zoom" type="range" min="70" max="220" value="100"></div>
              <div class="mini-range"><label>Horizontal</label><span id="profile-x-value">50%</span><input class="full" id="profile-x" type="range" min="0" max="100" value="50"></div>
              <div class="mini-range"><label>Vertical</label><span id="profile-y-value">50%</span><input class="full" id="profile-y" type="range" min="0" max="100" value="50"></div>
              <div><label>Encaixe</label><select id="profile-fit"><option value="cover">Preencher</option><option value="contain">Foto inteira</option></select></div>
            </div>
          </div>

          <div class="media-editor" data-kind="product" data-type="image">
            <div class="media-editor-head"><strong>Foto do produto</strong><span>Foto</span></div>
            <div class="editor-preview"><img id="editor-product-preview" alt="" /></div>
            <input id="product-file" type="file" accept="image/*" />
            <div class="media-controls">
              <div class="mini-range"><label>Zoom</label><span id="product-zoom-value">100%</span><input class="full" id="product-zoom" type="range" min="70" max="220" value="100"></div>
              <div class="mini-range"><label>Horizontal</label><span id="product-x-value">50%</span><input class="full" id="product-x" type="range" min="0" max="100" value="50"></div>
              <div class="mini-range"><label>Vertical</label><span id="product-y-value">50%</span><input class="full" id="product-y" type="range" min="0" max="100" value="50"></div>
              <div><label>Encaixe</label><select id="product-fit"><option value="cover">Preencher</option><option value="contain">Foto inteira</option></select></div>
            </div>
          </div>

          <div class="media-editor" data-kind="unboxing" data-type="video">
            <div class="media-editor-head"><strong>Vídeo de unboxing</strong><span>Vídeo</span></div>
            <div class="editor-preview"><video id="editor-unboxing-preview" controls playsinline muted></video></div>
            <input id="unboxing-file" type="file" accept="video/mp4,video/quicktime,video/webm" />
            <div class="media-controls">
              <div class="mini-range"><label>Zoom</label><span id="unboxing-zoom-value">100%</span><input class="full" id="unboxing-zoom" type="range" min="70" max="180" value="100"></div>
              <div class="mini-range"><label>Horizontal</label><span id="unboxing-x-value">50%</span><input class="full" id="unboxing-x" type="range" min="0" max="100" value="50"></div>
              <div class="mini-range"><label>Vertical</label><span id="unboxing-y-value">50%</span><input class="full" id="unboxing-y" type="range" min="0" max="100" value="50"></div>
              <div><label>Encaixe</label><select id="unboxing-fit"><option value="cover">Preencher</option><option value="contain">Vídeo inteiro</option></select></div>
            </div>
          </div>

          <div class="media-editor" data-kind="fitting" data-type="image">
            <div class="media-editor-head"><strong>Foto provador</strong><span>Foto</span></div>
            <div class="editor-preview"><img id="editor-fitting-preview" alt="" /></div>
            <input id="fitting-file" type="file" accept="image/*" />
            <div class="media-controls">
              <div class="mini-range"><label>Zoom</label><span id="fitting-zoom-value">100%</span><input class="full" id="fitting-zoom" type="range" min="70" max="220" value="100"></div>
              <div class="mini-range"><label>Horizontal</label><span id="fitting-x-value">50%</span><input class="full" id="fitting-x" type="range" min="0" max="100" value="50"></div>
              <div class="mini-range"><label>Vertical</label><span id="fitting-y-value">50%</span><input class="full" id="fitting-y" type="range" min="0" max="100" value="50"></div>
              <div><label>Encaixe</label><select id="fitting-fit"><option value="cover">Preencher</option><option value="contain">Foto inteira</option></select></div>
            </div>
          </div>
        </div>
      </div>

      <div class="actions"><button id="save-button" class="button button-primary" type="button">Salvar alterações</button><button id="reload-button" class="button button-secondary" type="button">Recarregar</button></div>
      <div id="status" class="status">Carregando configuração atual…</div>
    </section>

    <section class="preview-card">
      <div class="preview-toolbar"><strong>Pré-visualização da página</strong><span>todas as mídias respondem em tempo real</span></div>
      <div class="preview">
        <img id="preview-bg" class="preview-bg" src="/hero-fundo-leticia.jpg" alt="" />
        <div class="preview-scroll">
          <div class="preview-content">
            <div class="preview-avatar-wrap"><img id="preview-profile" class="preview-avatar" alt="" /></div>
            <div class="preview-kicker">UGC Creator • Moda • Beleza • Lifestyle</div><h2>Letícia Leite</h2><p>Conteúdo autêntico, estético e pensado para aproximar marcas de pessoas.</p>
            <div class="mock-links"><span>Ver portfólio</span><span>Pacotes & serviços</span><span>Falar comigo</span></div>
          </div>
          <div class="mini-title">Conteúdo em destaque</div>
          <div class="portfolio-preview-grid">
            <div class="portfolio-preview-item"><div class="portfolio-preview-media"><img id="preview-product" alt="" /></div><div class="portfolio-preview-label">Foto do produto</div></div>
            <div class="portfolio-preview-item"><div class="portfolio-preview-media"><video id="preview-unboxing" controls playsinline muted></video></div><div class="portfolio-preview-label">Vídeo de unboxing</div></div>
            <div class="portfolio-preview-item"><div class="portfolio-preview-media"><img id="preview-fitting" alt="" /></div><div class="portfolio-preview-label">Foto provador</div></div>
          </div>
        </div>
      </div>
    </section>
  </div>
</div>

<script>
  import { upload } from '@vercel/blob/client';

  const asset = (url) => ({ url, positionX:50, positionY:50, zoom:100, fit:'cover' });
  const defaults = {
    background:{url:'/hero-fundo-leticia.jpg',opacity:100,positionX:50,positionY:52,zoom:100,fit:'cover'},
    media:{
      profile:asset('/foto-perfil.jpg'),
      product:asset('/portfolio-produto.jpg'),
      unboxing:asset('/portfolio-unboxing.mp4'),
      fitting:asset('/portfolio-provador.jpg')
    }
  };
  const kinds=['profile','product','unboxing','fitting'];
  let state=structuredClone(defaults);
  const pendingFiles={background:null,profile:null,product:null,unboxing:null,fitting:null};
  const localUrls={background:'',profile:'',product:'',unboxing:'',fitting:''};
  const el=(id)=>document.getElementById(id);
  const status=el('status');

  function setStatus(message,type=''){status.textContent=message;status.className='status'+(type?' '+type:'')}
  function normalizeAsset(value,fallback){if(typeof value==='string')return{...fallback,url:value};return{...fallback,...(value||{})}}
  function srcFor(kind){return localUrls[kind]||state.media[kind].url||defaults.media[kind].url}
  function applyAsset(node,assetValue,kind){
    if(!node)return;
    const src=kind==='background'?(localUrls.background||state.background.url):srcFor(kind);
    if(node.tagName==='VIDEO'){
      if(node.src!==src){node.src=src;node.load()}
    }else if(node.src!==src){node.src=src}
    node.style.objectFit=assetValue.fit==='contain'?'contain':'cover';
    node.style.objectPosition=assetValue.positionX+'% '+assetValue.positionY+'%';
    node.style.transform='scale('+(assetValue.zoom/100)+')';
  }
  function syncBackground(){
    state.background.opacity=Number(el('opacity').value);state.background.zoom=Number(el('zoom').value);
    state.background.positionX=Number(el('position-x').value);state.background.positionY=Number(el('position-y').value);state.background.fit=el('fit').value;
    el('opacity-value').textContent=el('opacity').value+'%';el('zoom-value').textContent=el('zoom').value+'%';
    el('position-x-value').textContent=el('position-x').value+'%';el('position-y-value').textContent=el('position-y').value+'%';
  }
  function syncAsset(kind){
    const a=state.media[kind];a.zoom=Number(el(kind+'-zoom').value);a.positionX=Number(el(kind+'-x').value);a.positionY=Number(el(kind+'-y').value);a.fit=el(kind+'-fit').value;
    el(kind+'-zoom-value').textContent=a.zoom+'%';el(kind+'-x-value').textContent=a.positionX+'%';el(kind+'-y-value').textContent=a.positionY+'%';
  }
  function render(){
    syncBackground();
    const bg=el('preview-bg');bg.src=localUrls.background||state.background.url;bg.style.opacity=String(state.background.opacity/100);
    bg.style.objectFit=state.background.fit;bg.style.objectPosition=state.background.positionX+'% '+state.background.positionY+'%';bg.style.transform='scale('+(state.background.zoom/100)+')';
    kinds.forEach((kind)=>{syncAsset(kind);applyAsset(el('editor-'+kind+'-preview'),state.media[kind],kind);applyAsset(el('preview-'+kind),state.media[kind],kind)});
  }
  function loadControls(){
    el('opacity').value=String(state.background.opacity);el('zoom').value=String(state.background.zoom);el('position-x').value=String(state.background.positionX);el('position-y').value=String(state.background.positionY);el('fit').value=state.background.fit;
    kinds.forEach((kind)=>{const a=state.media[kind];el(kind+'-zoom').value=String(a.zoom);el(kind+'-x').value=String(a.positionX);el(kind+'-y').value=String(a.positionY);el(kind+'-fit').value=a.fit});
    render();
  }
  function clearLocal(kind){if(localUrls[kind])URL.revokeObjectURL(localUrls[kind]);localUrls[kind]='';pendingFiles[kind]=null}
  async function loadConfig(){
    setStatus('Carregando configuração atual…');
    try{
      const response=await fetch('/api/config?ts='+Date.now(),{cache:'no-store'});if(!response.ok)throw new Error('Não foi possível carregar a configuração.');
      const data=await response.json();state={background:{...defaults.background,...(data.background||{})},media:{}};
      kinds.forEach((kind)=>state.media[kind]=normalizeAsset(data.media?.[kind],defaults.media[kind]));
      Object.keys(localUrls).forEach(clearLocal);loadControls();setStatus('Configuração carregada. Escolha as mídias e ajuste como quiser.','ok');
    }catch(error){state=structuredClone(defaults);loadControls();setStatus(error instanceof Error?error.message:'Falha ao carregar.','error')}
  }
  function chooseFile(kind,file){clearLocal(kind);pendingFiles[kind]=file;localUrls[kind]=URL.createObjectURL(file);render();setStatus('Prévia atualizada. Ajuste a mídia e clique em Salvar alterações.','ok')}
  el('background-file').addEventListener('change',(event)=>{const file=event.target.files?.[0];if(file)chooseFile('background',file)});
  kinds.forEach((kind)=>{
    el(kind+'-file').addEventListener('change',(event)=>{const file=event.target.files?.[0];if(file)chooseFile(kind,file)});
    [kind+'-zoom',kind+'-x',kind+'-y',kind+'-fit'].forEach((id)=>{el(id).addEventListener('input',render);el(id).addEventListener('change',render)});
  });
  ['opacity','zoom','position-x','position-y','fit'].forEach((id)=>{el(id).addEventListener('input',render);el(id).addEventListener('change',render)});

  async function uploadPending(kind,password){
    const file=pendingFiles[kind];if(!file)return null;
    const extension=(file.name.split('.').pop()||(file.type.startsWith('video/')?'mp4':'jpg')).toLowerCase();
    const pathname='portfolio-leticia/media/'+kind+'.'+extension;
    const blob=await upload(pathname,file,{access:'public',handleUploadUrl:'/api/blob-upload',clientPayload:JSON.stringify({password,kind}),multipart:file.size>4*1024*1024});
    return blob.url;
  }

  el('save-button').addEventListener('click',async()=>{
    const password=el('admin-password').value.trim();if(!password){setStatus('Digite a senha do painel para salvar.','error');return}
    render();el('save-button').disabled=true;
    try{
      const pendingKinds=['background',...kinds].filter((kind)=>pendingFiles[kind]);
      for(const kind of pendingKinds){
        setStatus('Enviando '+pendingFiles[kind].name+'…');
        const url=await uploadPending(kind,password);
        if(kind==='background')state.background.url=url;else state.media[kind].url=url;
        clearLocal(kind);
      }
      setStatus('Salvando enquadramentos…');
      const response=await fetch('/api/config',{method:'POST',headers:{'Content-Type':'application/json','x-admin-password':password},body:JSON.stringify(state)});
      const data=await response.json().catch(()=>({}));
      if(!response.ok){if(data.error==='INVALID_PASSWORD')throw new Error('Senha incorreta.');throw new Error(data.error||'Não foi possível salvar.')}
      state=data.config;kinds.forEach((kind)=>state.media[kind]=normalizeAsset(state.media[kind],defaults.media[kind]));loadControls();
      setStatus('Tudo salvo e publicado no portfólio.','ok');
    }catch(error){setStatus(error instanceof Error?error.message:'Falha ao salvar.','error')}
    finally{el('save-button').disabled=false}
  });
  el('reload-button').addEventListener('click',loadConfig);
  loadConfig();
</script>
</body>
</html>
